ENVIRONMENT=development
LOG_LEVEL=INFO

# External database — point at your DB server.
# From inside a docker-compose container, "host.docker.internal" reaches the host machine.
# In production, set this to your real DB hostname (e.g. db.internal:5432).
DATABASE_URL=postgresql+asyncpg://postgres:0224@host.docker.internal:5432/biteplate
SYNC_DATABASE_URL=postgresql://postgres:0224@host.docker.internal:5432/biteplate

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=biteplate
KEYCLOAK_CLIENT_ID=biteplate-backend
KEYCLOAK_AUDIENCE=biteplate-backend

LOCATION_CODE=STANDARD

# Eskiz.uz SMS gateway. Sign up at eskiz.uz; leave blank to stub sends in the logs.
# Default ESKIZ_FROM=4546 is the Eskiz test sender — it only accepts the literal
# message "Это тест от Eskiz". Set a custom sender (nickname) once Eskiz approves it.
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=bekmurodovshohruh0224@gmail.com
ESKIZ_PASSWORD=iUTIAT3a1Bl0msOHe0hxxeIUgIPtbzXGGEOA3f3W
ESKIZ_FROM=4546

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
