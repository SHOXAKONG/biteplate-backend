# Local-development defaults. Used by `make dev`. Safe to commit.
# Production .env (which you maintain yourself) replaces all of these.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Local-dev DB lives on your host machine. From inside Docker, the host is
# reachable as host.docker.internal (already wired via extra_hosts in base compose).
# Make sure the "biteplate" database exists on your host Postgres before `make dev`.
DATABASE_URL=postgresql+asyncpg://postgres:biteplate@host.docker.internal:5432/biteplate
SYNC_DATABASE_URL=postgresql://postgres:biteplate@host.docker.internal:5432/biteplate

CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# KEYCLOAK_SERVER_URL = the issuer the browser sees (in token claims).
# KEYCLOAK_INTERNAL_URL = where the backend (inside Docker) fetches JWKS from.
# Local dev: your Keycloak runs on the host at :8080. The browser hits localhost,
# the backend hits host.docker.internal.
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_INTERNAL_URL=http://host.docker.internal:8080
KEYCLOAK_REALM=biteplate
KEYCLOAK_CLIENT_ID=biteplate-backend
KEYCLOAK_AUDIENCE=biteplate-backend
# Used by the backend to create users via Keycloak's admin REST API.
# Local dev: your existing Keycloak's superadmin creds.
KEYCLOAK_ADMIN_USERNAME=superadmin
KEYCLOAK_ADMIN_PASSWORD=0224

LOCATION_CODE=STANDARD

ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
